pipeline {
    agent any
    triggers { pollSCM('* * * * *') }      // check GitHub every minute
    stages {
        stage('Checkout') {
            steps { checkout scm }          // pull code from GitHub
        }
        stage('Run') {
            steps {
                sh 'python3 --version'
                sh 'python3 hello.py'
            }
        }
    }
}
